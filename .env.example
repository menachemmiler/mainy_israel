# =============================================================================
# מעייני ישראל — Environment template
# Copy to .env.local for development. Never commit real secrets.
# =============================================================================

# --- App ---
APP_URL=http://localhost:3000
NODE_ENV=development
AUTH_SECRET=replace-with-32-plus-char-random-string
# 32-byte hex key (64 hex chars) used to encrypt OAuth tokens at rest
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Database ---
# Local Docker (docker compose up -d):
# DATABASE_URL=postgresql://mayanei:mayanei@localhost:5432/mayanei?schema=public
#
# Neon pooled (Prisma): use the -pooler host. Drop channel_binding=require and add pgbouncer=true.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15&connection_limit=1

# --- Secrets driver: env | vault ---
# Local development uses the env driver. Production swaps to a cloud vault
# implementation in /services/secrets without changing bank logic.
SECRETS_DRIVER=env
# AWS_SECRETS_MANAGER_REGION=eu-west-1
# AWS_SECRET_ID=mayanei/production
# GOOGLE_SECRET_MANAGER_PROJECT=
# GOOGLE_SECRET_ID=mayanei-production

# --- FIBI / הבנק הבינלאומי ---
# sb  = sandbox  https://api.fibi.co.il:8443/fibi/sb
# prd = production https://api.fibi.co.il/fibi/prd
FIBI_ENV=prd
FIBI_BASE_URL=https://api.fibi.co.il/fibi/prd
FIBI_TOKEN_URL=https://api.fibi.co.il/fibi/prd/oauth/oauth2/token
FIBI_AUTHORIZE_URL=https://api.fibi.co.il/fibi/prd/oauth/oauth2/authorize
FIBI_CLIENT_ID=your-fibi-client-id
FIBI_CLIENT_SECRET=your-fibi-client-secret
FIBI_REDIRECT_URI=http://localhost:3000/api/fibi/oauth/callback
# mock = never POST drafts to the bank (v1 default until vendor verification)
# live = allow sandbox/production writes when the connection capability is verified
FIBI_WRITE_MODE=mock
FIBI_ACCEPT_LANGUAGE=HE

# --- Future connectors (unused in v1, reserved) ---
# PAGI_BASE_URL=
# PAGI_CLIENT_ID=
# PAGI_CLIENT_SECRET=

# --- Optional integrations (mocked in v1) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEDARIM_API_KEY=
# APT_API_KEY=
